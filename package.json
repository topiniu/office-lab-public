{
  "name": "office-lab-workspace",
  "version": "0.12.0",
  "private": true,
  "description": "望子成龙小学 · office-lab —— 仓根入口（只放 scripts；引擎在 app/、新 UI 在 web/，各自有独立 package.json）",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "start": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/bootstrap.mjs --doctor",
    "engine": "node app/server.js",
    "test": "node --test app/test/*.test.js",
    "test:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File tray/test/tray-logic.tests.ps1",
    "test:all": "npm test && npm run test:tray"
  }
}
